# MEDIXA PHARMA environment configuration
# NEVER put real passwords or secrets in this file.

# Flask security
MEDIXA_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MEDIXA_COOKIE_SECURE=0
MEDIXA_DEBUG=0

# Production PostgreSQL
# Render supplies this value.
DATABASE_URL=

# Local development SQLite
MEDIXA_DATABASE=pharma.db

# Application URL
MEDIXA_BASE_URL=

# Password reset
MEDIXA_DEV_RESET_LINK=0

# Business timezone
MEDIXA_TIMEZONE=Asia/Karachi

# SMTP / password-reset email
MEDIXA_SMTP_HOST=
MEDIXA_SMTP_PORT=587
MEDIXA_SMTP_USER=
MEDIXA_SMTP_PASSWORD=
MEDIXA_SMTP_FROM=